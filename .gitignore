# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Build outputs inside data/ — regenerated by scripts/gzip_web_files.py and
# scripts/version.py on every buildfs/uploadfs. Committing them means merge
# conflicts on binary blobs for no gain.
data/**/*.gz
data/fsver

# Local dev secrets (see src/secrets.h.example). Never commit this.
src/secrets.h

# Release staging
release/

# Python (scripts/boards.py is imported by version.py)
__pycache__/
*.pyc

# Editors / OS
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.DS_Store
*.swp
