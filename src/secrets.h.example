/**
 * Development secrets — OPTIONAL.
 *
 * Copy this file to src/secrets.h (which is gitignored) to flash dev builds
 * that join your WiFi directly, instead of walking through the setup AP after
 * every erase. If src/secrets.h does not exist, the build simply skips it.
 *
 *   cp src/secrets.h.example src/secrets.h
 *
 * These values OVERRIDE the stored config at boot, every boot. That is what
 * makes them convenient and also what makes them wrong for a real device:
 * provisioning through the web UI on a device with a secrets.h will appear to
 * work and then silently revert on the next reboot. Never ship a build with
 * this file present.
 */
#pragma once

#define DEV_WIFI_SSID     "your-network"
#define DEV_WIFI_PASSWORD "your-password"
